# Default values for every environment. Real environment variables win, and the
# Docker Compose files set the ones that matter, so this file is the local and
# CI fallback rather than the deployment configuration.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8000
###< symfony/routing ###

# Comma-separated list of origins allowed to call the API, matching the other
# velo-stats backends. The default is the Vite dev server.
CORS_ALLOWED_ORIGINS=http://localhost:5173

###> doctrine/doctrine-bundle ###
DATABASE_URL="sqlite:///%kernel.project_dir%/database/database.sqlite"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MESSENGER_TRANSPORT_DSN=redis://${REDIS_HOST}:${REDIS_PORT}
###< symfony/messenger ###

# Path to the rides JSON export, relative to the project root.
RIDES_JSON_PATH=data/rides.json

# Upstream services the background checks call.
VELO_ANTWERP_STATION_INFORMATION_URL=https://gbfs.smartbike.com/antwerp/1.0/en/station_information.json
OSRM_BASE_URL=https://routing.openstreetmap.de
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
